# ─── API Keys for Institutional Squawk & Macro Intelligence ──────────────────

# ─── Federal Reserve Economic Data (FRED) ─────────────────────────────────────
# Get your free API key at: https://fred.stlouisfed.org/docs/api/fred/
# Used for: Fed Balance Sheet Total Assets, Treasury General Account, Reverse Repo
FRED_API_KEY=your_fred_api_key_here

# ─── Financial Modeling Prep (FMP) ─────────────────────────────────────────────
# Get your API key at: https://site.financialmodelingprep.com/developer/docs
# Used for: Analyst revisions, price targets, institutional ownership data
FMP_API_KEY=your_fmp_api_key_here

# ─── Twitter/X API ────────────────────────────────────────────────────────────
# Get your Bearer Token at: https://developer.twitter.com/en/portal/dashboard
# Required permissions: tweet.read, users.read
# Used for: Whitelisted institutional squawk sources (@zerohedge, @FirstSquawk, etc)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ─── Optional: Bloomberg Terminal ──────────────────────────────────────────────
# If you have enterprise access to Bloomberg Terminal via API
# BLOOMBERG_API_KEY=your_bloomberg_api_key_here

# ─── Optional: EODHD API ───────────────────────────────────────────────────────
# Alternative to FMP for institutional data
# EODHD_API_KEY=your_eodhd_api_key_here
