# ─────────────────────────────────────────────────────────────────────────────
# CROSSED MATRIX — Environment Variables
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Deployment ───────────────────────────────────────────────────────────────
# Required in production (Vercel): your app's public base URL.
# Used by server-side routes to call /api/alpaca via full URL.
# Leave blank in local dev (defaults to http://localhost:3000).
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# ─── Alpaca Markets ──────────────────────────────────────────────────────────
# Get your keys at: https://app.alpaca.markets/ → API Keys
# Used for: live ETF/crypto snapshots, historical daily bars (free IEX feed)
# Server-side only — never exposed to the browser.
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ─── Federal Reserve Economic Data (FRED) ────────────────────────────────────
# Free key at: https://fred.stlouisfed.org/docs/api/fred/
# Used for: Fed balance sheet (WALCL), Treasury Account (WTREGEN), Reverse Repo (RRPONTSYD),
#           yield curve (DGS2/DGS10), HY spreads (BAMLH0A0HYM2), financial stress (STLFSI4)
FRED_API_KEY=your_fred_api_key_here

# ─── Financial Modeling Prep (FMP) ───────────────────────────────────────────
# Key at: https://site.financialmodelingprep.com/developer/docs
# Used for: index spot levels (^VIX, ^GSPC, ^NDX), vol indices as fallback
# The dashboard degrades gracefully when this is absent (uses Alpaca ETF proxies).
FMP_API_KEY=your_fmp_api_key_here

# ─── Interactive Brokers (IBKR) — optional ───────────────────────────────────
# Only needed when running the IB Client Portal Gateway locally.
# Configure your TWS/Gateway to listen on the port specified here.
IB_SOCKET_HOST=127.0.0.1
IB_SOCKET_PORT=4002
IB_CLIENT_ID=7

# ─── Python IB Bridge (futures live streaming) — optional ───────────────────
# URL of your Python bridge server (bridge/main.py → IB Gateway for ES/NQ/ZN).
# In production (Railway/Render), set this to the public URL of that service.
# Leave blank in local dev (defaults to http://localhost:8000).
NEXT_PUBLIC_IB_BRIDGE_URL=https://your-ib-bridge.railway.app

# ─── Authentication ───────────────────────────────────────────────────────────
# Signing secret for session JWTs. Use a long random string in production.
# Generate: `openssl rand -base64 32`
JWT_SECRET=change-me-to-a-long-random-string-minimum-32-chars

# ─── Anthropic (Claude chat) — optional ──────────────────────────────────────
# Required only if you use the /api/chat endpoint for Claude integration.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Twitter/X API — optional ────────────────────────────────────────────────
# Bearer Token from https://developer.twitter.com/en/portal/dashboard
# Required permissions: tweet.read, users.read
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
